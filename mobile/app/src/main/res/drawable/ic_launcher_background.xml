<?xml version="1.0" encoding="utf-8"?>
<!--
  Night, with the first warmth in it.

  A radial glow centred exactly where the icon's sun sits, so the background is not a backdrop
  the mark is placed on but the light the mark is emitting. Deep indigo at the edges because an
  alarm belongs to the dark end of the morning, not to daylight.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="66"
                android:gradientRadius="76">
                <item android:offset="0.0" android:color="#FF3E2270" />
                <item android:offset="0.5" android:color="#FF261548" />
                <item android:offset="1.0" android:color="#FF130B27" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
